generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
}

model Category {
  category_id   Int     @id @default(autoincrement())
  category_name String  @db.VarChar(50)
  combos        Combo[]
  dishes        Dish[]

  @@map("categories")
}

model Size {
  size_id     Int         @id @default(autoincrement())
  size_name   String      @db.VarChar(50)
  is_visible  Boolean?    @default(true)
  dish_prices DishPrice[]
  toppings    Topping[]

  @@map("sizes")
}

model Crust {
  crust_id    Int         @id @default(autoincrement())
  crust_name  String      @db.VarChar(50)
  is_visible  Boolean?    @default(true)
  dish_prices DishPrice[]

  @@map("crusts")
}

model Topping {
  topping_id       Int      @id @default(autoincrement())
  topping_name     String   @db.VarChar(50)
  price_topping    Int?     @default(0)
  size_id          Int?
  is_for_pizza     Boolean? @default(true)
  is_for_spaghetti Boolean? @default(true)
  sizes            Size?    @relation(fields: [size_id], references: [size_id], onDelete: NoAction, onUpdate: NoAction)
  order_item_toppings OrderItemTopping[]

  @@map("toppings")
}

model Dish {
  dish_id     Int         @id @default(autoincrement())
  category_id Int?
  dish_name   String      @db.VarChar(100)
  image       String?
  ingredient  String?
  dish_status Boolean?
  prices      DishPrice[]
  category    Category?   @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  order_item_halves OrderItemHalf[]

  @@map("dishes")
}

model DishPrice {
  dish_price_id String      @id @db.VarChar(100)
  dish_id       Int?
  size_id       Int?
  crust_id      Int?
  dish_price    Int?        @default(0)
  combo_items   ComboItem[]
  crust         Crust?      @relation(fields: [crust_id], references: [crust_id], onDelete: NoAction, onUpdate: NoAction)
  dish          Dish?       @relation(fields: [dish_id], references: [dish_id], onDelete: Cascade, onUpdate: NoAction)
  size          Size?       @relation(fields: [size_id], references: [size_id], onDelete: NoAction, onUpdate: NoAction)
  order_items   OrderItem[]
  order_item_combos OrderItemCombo[]

  @@map("dish_prices")
}

model Combo {
  combo_id    Int          @id @default(autoincrement())
  combo_name  String       @db.VarChar(100)
  combo_price Int
  description String?
  is_active   Boolean?     @default(true)
  category_id Int?
  image_combo String?
  groups      ComboGroup[]
  categories  Category?    @relation(fields: [category_id], references: [category_id], onDelete: NoAction, onUpdate: NoAction)
  order_items   OrderItem[]

  @@map("combos")
}

model ComboGroup {
  group_id    String      @id @db.VarChar(50)
  combo_id    Int?
  group_name  String
  min_select  Int?        @default(1)
  max_select  Int?        @default(1)
  combo       Combo?      @relation(fields: [combo_id], references: [combo_id], onDelete: Cascade, onUpdate: NoAction)
  combo_items ComboItem[]

  @@map("combo_groups")
}

model ComboItem {
  combo_item_id Int         @id @default(autoincrement())
  group_id      String?     @db.VarChar(50)
  dish_price_id String?     @db.VarChar(100)
  price_extra   Int?        @default(0)
  dish_price    DishPrice?  @relation(fields: [dish_price_id], references: [dish_price_id], onDelete: Cascade, onUpdate: NoAction)
  group         ComboGroup? @relation(fields: [group_id], references: [group_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("combo_items")
}

model Store {
  store_id   Int      @id @default(autoincrement())
  store_name String?  @db.VarChar(255)
  address    String?
  latitude   Decimal? @db.Decimal
  longitude  Decimal? @db.Decimal
  hotline    String?  @db.VarChar(100)
  is_active  Boolean?
  orders     Order[]

  @@map("stores")
}

model User {
  user_id       Int           @id @default(autoincrement())
  username      String?       @db.VarChar(100)
  email         String?       @db.VarChar(100)
  phone         String?       @db.VarChar(20)
  password      String?       @db.VarChar(255)
  role          String?       @db.VarChar(50)
  user_status   Boolean?
  created_at    DateTime?     @db.Timestamptz(6)
  is_guest      Boolean?      @default(false)
  google_id     String?       @unique @db.VarChar(255)
  auth_provider String?       @default("local") @db.VarChar(50)
  avatar        String?       @db.VarChar(255)
  cart          Cart[]
  orders        Order[]
  reviews       ShopReview[]
  addresses     UserAddress[]
  chat_rooms    ChatRoom[]
  messages      Message[]
  chatbot_sessions ChatbotSession[]

  @@map("users")
}

model UserAddress {
  user_address_id Int      @id @default(autoincrement())
  user_id         Int?
  address_line    String?
  is_default      Boolean?
  orders          Order[]
  user            User?    @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("user_address")
}

model Cart {
  cart_id          Int        @id @default(autoincrement())
  user_id          Int?
  created_at       DateTime?  @db.Timestamptz(6)
  total_price_cart Int?
  items            CartItem[]
  user             User?      @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("carts")
}

model CartItem {
  cart_item_id   Int               @id @default(autoincrement())
  cart_id        Int?
  dish_price_id  String?           @db.VarChar(100)
  combo_id       Int?
  quantity       Int?
  is_half_half   Boolean?
  price_cart     Int?
  cart_item_note String?
  combos         CartItemCombo[]
  halves         CartItemHalf[]
  toppings       CartItemTopping[]
  cart           Cart?             @relation(fields: [cart_id], references: [cart_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("cart_items")
}

model CartItemTopping {
  item_topping_id    Int            @id @default(autoincrement())
  cart_item_id       Int?
  cart_item_combo_id Int?
  cart_item_half_id  Int?
  topping_id         Int?
  quantity           Int?
  cart_item_combo    CartItemCombo? @relation(fields: [cart_item_combo_id], references: [cart_item_combo_id], onDelete: NoAction, onUpdate: NoAction)
  cart_item_half     CartItemHalf?  @relation(fields: [cart_item_half_id], references: [cart_item_half_id], onDelete: NoAction, onUpdate: NoAction)
  cart_item          CartItem?      @relation(fields: [cart_item_id], references: [cart_item_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("cart_item_topping")
}

model CartItemCombo {
  cart_item_combo_id Int               @id @default(autoincrement())
  cart_item_id       Int?
  group_id           String?           @db.VarChar(50)
  dish_price_id      String?           @db.VarChar(100)
  is_half_half       Boolean?
  cart_combo_note    String?
  cart_item          CartItem?         @relation(fields: [cart_item_id], references: [cart_item_id], onDelete: NoAction, onUpdate: NoAction)
  halves             CartItemHalf[]
  toppings           CartItemTopping[]

  @@map("cart_item_combos")
}

model CartItemHalf {
  cart_item_half_id  Int               @id @default(autoincrement())
  cart_item_id       Int?
  cart_item_combo_id Int?
  dish_id            Int?
  cart_half_note     String?
  cart_item_combo    CartItemCombo?    @relation(fields: [cart_item_combo_id], references: [cart_item_combo_id], onDelete: NoAction, onUpdate: NoAction)
  cart_item          CartItem?         @relation(fields: [cart_item_id], references: [cart_item_id], onDelete: NoAction, onUpdate: NoAction)
  cart_item_topping  CartItemTopping[]

  @@map("cart_item_half")
}

model Order {
  order_id                Int          @id @default(autoincrement())
  user_id                 Int?
  user_address_id         Int?
  payment_method          String?      @db.VarChar(50)
  payment_status          String?      @db.VarChar(50)
  total_price_dish        Int?
  shipping_fee            Int?
  discount_amount         Int?
  total_order             Int?
  order_note              String?
  created_at              DateTime?    @db.Timestamptz(6)
  order_status            String?      @db.VarChar(50)
  confirmed_at            DateTime?    @db.Timestamptz(6)
  preparing_at            DateTime?    @db.Timestamptz(6)
  shipped_at              DateTime?    @db.Timestamptz(6)
  estimated_delivery_time DateTime?    @db.Timestamptz(6)
  arrived_at              DateTime?    @db.Timestamptz(6)
  completed_at            DateTime?    @db.Timestamptz(6)
  cancelled_at            DateTime?    @db.Timestamptz(6)
  order_type              String?      @db.VarChar(50)
  pickup_time             DateTime?    @db.Timestamptz(6)
  customer_name           String?      @db.VarChar(255)
  customer_phone          String?      @db.VarChar(20)
  customer_email          String?      @db.VarChar(255)
  store_id                Int?
  customer_latitude       Decimal?     @db.Decimal(10, 7)
  customer_longitude      Decimal?     @db.Decimal(10, 7)
  shipping_distance_meters Decimal?
  items                   OrderItem[]
  user_address            UserAddress? @relation(fields: [user_address_id], references: [user_address_id], onDelete: NoAction, onUpdate: NoAction)
  user                    User?        @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  store                   Store?       @relation(fields: [store_id], references: [store_id], onDelete: NoAction, onUpdate: NoAction)
  reviews                 ShopReview[]
  transactions            Transaction[]

  @@map("orders")
}

model OrderItem {
  order_item_id   Int                @id @default(autoincrement())
  order_id        Int?
  dish_price_id   String?            @db.VarChar(100)
  combo_id        Int?
  quantity        Int?
  is_half_half    Boolean?
  order_price     Int?
  order_item_note String?
  combos          OrderItemCombo[]
  halves          OrderItemHalf[]
  toppings        OrderItemTopping[]
  order           Order?             @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  dish_price      DishPrice?         @relation(fields: [dish_price_id], references: [dish_price_id], onDelete: NoAction, onUpdate: NoAction)
  combo           Combo?             @relation(fields: [combo_id], references: [combo_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_items")
}

model OrderItemTopping {
  order_item_topping_id Int             @id @default(autoincrement())
  order_item_id         Int?
  order_item_combo_id   Int?
  order_item_half_id    Int?
  topping_id            Int?
  quantity              Int?
  topping_price         Int?
  order_item_combo      OrderItemCombo? @relation(fields: [order_item_combo_id], references: [order_item_combo_id], onDelete: NoAction, onUpdate: NoAction)
  order_item_half       OrderItemHalf?  @relation(fields: [order_item_half_id], references: [order_item_half_id], onDelete: NoAction, onUpdate: NoAction)
  order_item            OrderItem?      @relation(fields: [order_item_id], references: [order_item_id], onDelete: NoAction, onUpdate: NoAction)
  topping               Topping?        @relation(fields: [topping_id], references: [topping_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_item_toppings")
}

model OrderItemCombo {
  order_item_combo_id Int                @id @default(autoincrement())
  order_item_id       Int?
  group_id            String?            @db.VarChar(50)
  dish_price_id       String?            @db.VarChar(100)
  is_half_half        Boolean?
  order_combo_note    String?
  order_item          OrderItem?         @relation(fields: [order_item_id], references: [order_item_id], onDelete: NoAction, onUpdate: NoAction)
  halves              OrderItemHalf[]
  toppings            OrderItemTopping[]
  dish_price          DishPrice?         @relation(fields: [dish_price_id], references: [dish_price_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_item_combos")
}

model OrderItemHalf {
  order_item_half_id  Int                @id @default(autoincrement())
  order_item_id       Int?
  order_item_combo_id Int?
  dish_id             Int?
  order_half_note     String?
  order_item_combo    OrderItemCombo?    @relation(fields: [order_item_combo_id], references: [order_item_combo_id], onDelete: NoAction, onUpdate: NoAction)
  order_item          OrderItem?         @relation(fields: [order_item_id], references: [order_item_id], onDelete: NoAction, onUpdate: NoAction)
  order_item_toppings OrderItemTopping[]
  dish                Dish?              @relation(fields: [dish_id], references: [dish_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("order_item_half")
}

model ShopReview {
  review_id    Int                @id @default(autoincrement())
  user_id      Int?
  order_id     Int?
  rating_star  Int?
  comment      String?
  image_url    String?
  shop_reply   String?
  created_at   DateTime?          @db.Timestamptz(6)
  is_visible   Boolean?
  order        Order?             @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)
  user         User?              @relation(fields: [user_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  item_ratings ReviewItemRating[]

  @@map("shop_reviews")
}

model ReviewItemRating {
  id          Int        @id @default(autoincrement())
  review_id   Int
  dish_name   String     @db.VarChar(255)
  dish_image  String?
  rating_star Int
  review      ShopReview @relation(fields: [review_id], references: [review_id], onDelete: Cascade)

  @@map("review_item_ratings")
}

model ChatRoom {
  room_id          Int            @id @default(autoincrement())
  customer_id      Int?
  guest_session_id String?        @db.VarChar(100)
  guest_name       String?        @db.VarChar(100)
  guest_phone      String?        @db.VarChar(20)
  guest_address    String?
  room_status      String         @default("pending") @db.VarChar(20)
  created_at       DateTime?      @default(now()) @db.Timestamptz(6)
  updated_at       DateTime?      @default(now()) @db.Timestamptz(6)
  customer         User?          @relation(fields: [customer_id], references: [user_id], onDelete: Cascade, onUpdate: NoAction)
  messages         Message[]

  @@map("chat_rooms")
}

model Message {
  message_id   Int            @id @default(autoincrement())
  room_id      Int
  sender_type  String         @db.VarChar(20)
  sender_id    Int?
  message_text String
  is_read      Boolean        @default(false)
  created_at   DateTime?      @default(now()) @db.Timestamptz(6)
  chat_room    ChatRoom       @relation(fields: [room_id], references: [room_id], onDelete: Cascade, onUpdate: NoAction)
  sender       User?          @relation(fields: [sender_id], references: [user_id], onDelete: NoAction, onUpdate: NoAction)
  images       MessageImage[]

  @@map("messages")
}

model MessageImage {
  image_id    Int       @id @default(autoincrement())
  message_id  Int
  image_url   String    @db.VarChar(255)
  uploaded_at DateTime? @default(now()) @db.Timestamptz(6)
  message     Message   @relation(fields: [message_id], references: [message_id], onDelete: Cascade, onUpdate: NoAction)

  @@map("message_images")
}

model Transaction {
  id                  Int       @id @default(autoincrement())
  gateway             String    @db.VarChar(100)
  transaction_date    DateTime? @db.Timestamptz(6)
  account_number      String?   @db.VarChar(100)
  sub_account         String?   @db.VarChar(250)
  amount_in           Decimal   @default(0.00) @db.Decimal(20, 2)
  amount_out          Decimal   @default(0.00) @db.Decimal(20, 2)
  accumulated         Decimal   @default(0.00) @db.Decimal(20, 2)
  code                String?   @db.VarChar(250)
  transaction_content String?   @db.Text
  reference_number    String?   @db.VarChar(255)
  body                String?   @db.Text
  created_at          DateTime  @default(now()) @db.Timestamptz(6)
  order_id            Int?
  order               Order?    @relation(fields: [order_id], references: [order_id], onDelete: NoAction, onUpdate: NoAction)

  @@map("tb_transactions")
}

model PolicyChapter {
  id           String          @id @db.VarChar(100)
  chapter_name String          @db.VarChar(255)
  last_updated DateTime        @db.Date
  created_at   DateTime?       @default(now()) @db.Timestamptz(6)
  sections     PolicySection[]

  @@map("policy_chapters")
}

model PolicySection {
  id            Int             @id @default(autoincrement())
  chapter_id    String?         @db.VarChar(100)
  section_number String          @db.VarChar(50)
  title_section String          @db.VarChar(255)
  display_order Int?            @default(0)
  chapter       PolicyChapter?  @relation(fields: [chapter_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sub_items     PolicySubItem[]

  @@map("policy_sections")
}

model PolicySubItem {
  id            Int            @id @default(autoincrement())
  section_id    Int?
  item_number   String?        @db.VarChar(50)
  content       String         @db.Text
  display_order Int?           @default(0)
  section       PolicySection? @relation(fields: [section_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("policy_sub_item")
}

model ChatbotSession {
  session_id     Int              @id @default(autoincrement())
  user_id        Int?
  guest_id       String?          @db.VarChar(100)
  started_at     DateTime         @default(now()) @db.Timestamptz(6)
  ended_at       DateTime?        @db.Timestamptz(6)
  total_messages Int              @default(0)
  last_intent    String?          @db.VarChar(50)
  is_active      Boolean          @default(true)
  user           User?            @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  messages       ChatbotMessage[]

  @@map("chatbot_sessions")
}

model ChatbotMessage {
  message_id   Int            @id @default(autoincrement())
  session_id   Int
  role         String         @db.VarChar(20)
  content      String         @db.Text
  intent       String?        @db.VarChar(50)
  dishes_count Int?           @default(0)
  created_at   DateTime       @default(now()) @db.Timestamptz(6)
  session      ChatbotSession @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@map("chatbot_messages")
}

