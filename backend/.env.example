# Kết nối Cơ sở dữ liệu PostgreSQL
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/pizza?schema=public"

# Cấu hình Cổng & Môi trường
PORT=4000
NODE_ENV=development

# Bảo mật JWT
JWT_SECRET="pizza_pasta_inn_secret_key_2026"
JWT_EXPIRES_IN="7d"

# Cấu hình gửi Email xác thực / đơn hàng (Tùy chọn - Gmail App Password)
GMAIL_USER="your_email@gmail.com"
GMAIL_APP_PASSWORD="your_16_char_app_password"

# Cấu hình Bản đồ tính khoảng cách giao hàng (Tùy chọn)
MAPTILER_API_KEY=""

# Cấu hình Webhook thanh toán SePay (Tùy chọn)
SEPAY_WEBHOOK_SECRET=""

# Cấu hình Redis Cache (Tùy chọn - hệ thống tự hoạt động bình thường nếu không bật Redis)
REDIS_URL="redis://localhost:6379"
